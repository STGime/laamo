{
  "$schema": "../template.schema.json",
  "schema": 1,
  "slug": "mail-report-check",
  "name": {
    "en": "Mail Report Checker",
    "de": "Mail-Report-Prüfer"
  },
  "promise": {
    "en": "Forward the DMARC reports mail providers send about your domain. Each one is checked and saved to a list with its result: all good, a minor problem, or a problem. You hear about it only when something failed.",
    "de": "Leite die DMARC-Reports weiter, die Mail-Anbieter zu deiner Domain schicken. Jeder wird geprüft und mit Ergebnis in einer Liste gespeichert: alles gut, kleines Problem oder Problem. Du hörst nur davon, wenn etwas durchgefallen ist."
  },
  "category": "sort_emails",
  "avatar": "🛡️",
  "sort_order": 58,
  "setup_questions": [],
  "stack": {
    "schema": 1,
    "bricks": [
      {
        "id": "b1",
        "type": "when.email",
        "config": {}
      },
      {
        "id": "b2",
        "type": "think.extract",
        "config": {
          "fields": [
            "result",
            "report_from",
            "report_domain",
            "report_period",
            "emails_total",
            "emails_passed",
            "emails_failed",
            "failed_sources"
          ],
          "only_found": false
        }
      },
      {
        "id": "b3",
        "type": "do.list",
        "config": {
          "list": {
            "en": "Mail reports",
            "de": "Mail-Reports"
          },
          "dedupe": "none",
          "only_new": false
        }
      },
      {
        "id": "b4",
        "type": "think.keep",
        "config": {
          "criteria": {
            "en": "report a problem: the result does not start with “All good”",
            "de": "ein Problem melden: Das Ergebnis (result) beginnt nicht mit „All good“"
          },
          "max": 5,
          "sort": "original"
        }
      },
      {
        "id": "b5",
        "type": "think.summarize",
        "config": {
          "length": "short",
          "mode": "all",
          "language": "auto"
        }
      }
    ],
    "limits": {
      "max_cards": 5,
      "max_external_emails": 0,
      "max_cost_eur": 0.05
    }
  },
  "required": {
    "brain": true
  }
}
