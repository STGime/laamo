{
  "$schema": "../template.schema.json",
  "schema": 1,
  "slug": "morning-briefing",
  "name": { "en": "Morning Briefing", "de": "Morgen-Briefing" },
  "promise": {
    "en": "Every weekday at 7:30, the 5 most important local news for your business in your chat.",
    "de": "Jeden Werktag um 7:30 die 5 wichtigsten lokalen Neuigkeiten für dein Geschäft in deinem Chat."
  },
  "category": "stay_up_to_date",
  "avatar": "📰",
  "sort_order": 10,
  "setup_questions": [
    { "profile": "business" },
    { "profile": "city" },
    {
      "key": "chat",
      "type": "place",
      "question": {
        "en": "Where should I tell you?",
        "de": "Wo soll ich dir Bescheid geben?"
      },
      "fills": [{ "brick": "b5", "setting": "place" }]
    }
  ],
  "stack": {
    "schema": 1,
    "bricks": [
      {
        "id": "b1",
        "type": "when.every",
        "config": { "freq": "weekdays", "time": "07:30" }
      },
      {
        "id": "b2",
        "type": "look.search",
        "config": {
          "query": {
            "en": "{my business} {my city} news",
            "de": "{my business} {my city} Neuigkeiten"
          },
          "count": 10,
          "freshness": "day"
        }
      },
      {
        "id": "b3",
        "type": "think.keep",
        "config": {
          "criteria": {
            "en": "matter most to a {my business} in {my city}",
            "de": "für mein Geschäft ({my business} in {my city}) am wichtigsten sind"
          },
          "max": 5,
          "sort": "best"
        }
      },
      {
        "id": "b4",
        "type": "think.summarize",
        "config": { "length": "short", "mode": "all", "language": "auto" }
      },
      { "id": "b5", "type": "do.chat", "config": { "mode": "one" } }
    ],
    "limits": { "max_cards": 50, "max_external_emails": 0, "max_cost_eur": 0.2 }
  },
  "required": {
    "brain": true,
    "places": ["discord", "slack", "teams", "telegram"]
  }
}
