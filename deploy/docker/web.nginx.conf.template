# The web app and its API on one domain: /api goes to the api container
# (API_UPSTREAM, e.g. https://laamo-api-xxxx.functions.fnc.fr-par.scw.cloud),
# so the browser needs no CORS. Filled in by envsubst when nginx starts.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Staging asks for a login (deploy/README.md, "Staging login"); "off"
    # everywhere else. BASIC_AUTH comes from 15-basic-auth.envsh.
    auth_basic "${BASIC_AUTH}";
    auth_basic_user_file /etc/nginx/conf.d/htpasswd;

    # Scaleway's health check, which has no login.
    location = /healthz {
        auth_basic off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API has its own sign-in (a Bearer token in the same Authorization
    # header a login would use), so it stays outside the staging login.
    location /api/ {
        auth_basic off;
        proxy_pass ${API_UPSTREAM};
        proxy_ssl_server_name on;            # https upstream: send its name (SNI)
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Live updates (Server-Sent Events) stream through unbuffered.
        proxy_buffering off;
        proxy_read_timeout 1h;
        # Forwarded emails may be up to 15 MB (mail.MaxInbound).
        client_max_body_size 16m;
    }

    # Text is sent compressed (HTML, scripts, styles, JSON, SVG): about a
    # quarter of the size on a phone connection.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/markdown application/javascript application/json
               application/xml application/yaml application/manifest+json image/svg+xml;

    # An address that doesn't exist gets the site's own page with status 404
    # (in German under /de), never the app with status 200: search engines
    # would take every mistyped address for a real, empty page.
    error_page 404 /404.html;

    # Hashed build assets can be cached forever.
    location ^~ /_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    # Pictures, icons and fonts: a day.
    location ~* \.(png|jpg|svg|ico|woff2)$ {
        add_header Cache-Control "public, max-age=86400";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    # The home-screen manifest, with its proper type.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "public, max-age=86400";
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # The app's screens are drawn in the browser from app.html. The list is
    # APP_ROUTES in apps/web/src/lib/site/site.ts (a test keeps them equal).
    location ~ ^/(auth|feed|helpers|kit|lists|me|new|places|shared|signin|start|welcome)(/|$) {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files /app.html =404;
    }

    # Everything else is the site, prerendered (/ → index.html, /de →
    # de.html, /llms.txt, /sitemap.xml, …).
    location / {
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri $uri.html $uri/index.html =404;
    }
    location /de/ {
        error_page 404 /de/404.html;
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri $uri.html $uri/index.html =404;
    }

    # The not-found pages themselves, and the app's shell, aren't for search
    # engines.
    location ~ ^/(de/)?404\.html$ {
        internal;
        add_header Cache-Control "no-cache" always;
        add_header X-Robots-Tag "noindex" always;
    }
    location = /app.html {
        internal;
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex";
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}
