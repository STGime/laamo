# Settings for one environment. Copy to deploy/staging.env (or prod.env);
# those files are gitignored. Everything below except the SCW_* and WEB_*
# lines is handed to the api and worker as secret environment variables.

# Scaleway: the registry namespace (rg.fr-par.scw.cloud/<this>). The scw
# CLI's own profile (scw init) picks the project and credentials.
SCW_REGISTRY_NAMESPACE=laamo
# Optional: the web app's own domain (a CNAME to the web container first).
WEB_DOMAIN=

# Eurobase project of this environment
EUROBASE_URL=https://laamo.eurobase.app
EUROBASE_PROJECT_ID=
EUROBASE_PUBLIC_KEY=
EUROBASE_PRIVATE_KEY=

# Secrets at rest (docs/security/secrets.md)
LAAMO_MASTER_KEYS=
LAAMO_MASTER_KEY_ACTIVE=

# AI brain and pictures (fal.ai)
FAL_KEY=

# Search the web, Find businesses
BRAVE_SEARCH_API_KEY=
GEOAPIFY_API_KEY=

# Incoming email: the same secret as the Cloudflare Email Worker's
INBOUND_DOMAIN=in.laamo.app
INBOUND_SECRET=

# Public demo: one key for all api instances
LAAMO_DEMO_SECRET=
