# Copy to .env and fill in. Never commit .env.

# Eurobase (dev project)
EUROBASE_URL=https://laamo.eurobase.app
# Project id (tokens must be issued for it). Defaults to the laamo dev project in dev.
EUROBASE_PROJECT_ID=
EUROBASE_PUBLIC_KEY=
# Secret key: server side only (api, worker, mailin). Never in the web app.
EUROBASE_PRIVATE_KEY=

# Brave Search (dev key ~1 req/s)
BRAVE_SEARCH_API_KEY=

# Local ports
API_ADDR=:8787

# Master keys for secrets at rest (webhook URLs, chat ids, own AI keys).
# Format id:base64, comma separated; the last one encrypts new secrets.
# Make one with: echo "v1:$(openssl rand -base64 32)"
# Required outside dev. See docs/security/secrets.md for rotation.
LAAMO_MASTER_KEYS=
LAAMO_MASTER_KEY_ACTIVE=

# AI brain (OpenAI-compatible). Default: Mistral Small through fal.ai, key from FAL_KEY.
# Mistral direct: LLM_BASE_URL=https://api.mistral.ai/v1 LLM_AUTH=Bearer LLM_MODEL=mistral-small-latest LLM_API_KEY=...
FAL_KEY=
# (FAL_AI_API_KEY is accepted too)
LLM_API_KEY=
LLM_BASE_URL=
LLM_AUTH=
LLM_MODEL=
